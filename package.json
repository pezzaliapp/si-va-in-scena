{
  "name": "si-va-in-scena",
  "private": true,
  "version": "0.1.0",
  "description": "SI VA IN SCENA — PWA per lo studio e le prove di copioni teatrali, interamente locale.",
  "author": "Alessandro Pezzali",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pezzaliapp/si-va-in-scena.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "icons": "node scripts/make-icons.mjs",
    "diagnose": "node scripts/diagnose-pdf.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "idb": "8.0.4",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
